
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<header class="client-header">

    <div class="client-header-inner">

        <!-- Brand -->
        <a class="brand" href="${ctx}/client/dashboard">
            <span class="brand-mark" aria-hidden="true">J</span>
            <span class="brand-name">JakLoc</span>
        </a>

        <!-- Navigation -->
        <%@ include file="/WEB-INF/views/client/includes/nav.jspf" %>

        <!-- User Account -->
        <div class="client-account">

            <div class="user-chip">

                <span class="avatar" aria-hidden="true">
                    <c:choose>
                        <c:when test="${not empty sessionScope.authenticatedUser.fullName}">
                            <c:out value="${sessionScope.authenticatedUser.fullName.substring(0, 1)}" />
                        </c:when>
                        <c:otherwise>
                            U
                        </c:otherwise>
                    </c:choose>
                </span>

                <span class="user-meta">

                    <strong>
                        <c:out value="${sessionScope.authenticatedUser.fullName}" />
                    </strong>

                    <small>
                        <c:out value="${sessionScope.authenticatedUser.email}" />
                    </small>

                </span>

            </div>

            <!-- Logout -->
            <form class="logout-form"
                  action="${ctx}/logout"
                  method="post">

                <button class="btn btn-ghost btn-sm" type="submit">
                    Sign out
                </button>

            </form>

        </div>

    </div>

</header>
